# Application
APP_NAME=PlanOS
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://planos:planos@localhost:5432/planos
DATABASE_URL_SYNC=postgresql://planos:planos@localhost:5432/planos

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=jwt-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_TEMPERATURE=0.1

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=planos

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
